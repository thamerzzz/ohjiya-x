# Public entry point for Ohjiya X. Caddy gets and renews the HTTPS certificate
# for the domain by itself; the app is never exposed directly.
{$SITE_DOMAIN:x.ohjiya.sa} {
	encode zstd gzip

	# Public. Access control is the app's own sign-in (OHJIYA_AUTH=on), which gates voice,
	# chat and the paid data routes by plan. The earlier basic_auth password gate was removed.

	reverse_proxy app:4173
}

# Extra sites (for example the staging hosts): copy a .caddy.example file from
# deploy/sites/ to deploy/sites/<name>.caddy. No files means nothing extra is served.
import /etc/caddy/sites/*.caddy
