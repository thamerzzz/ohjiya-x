# Copy to deploy/.env and fill in. Never commit deploy/.env.
SITE_DOMAIN=x.ohjiya.sa

# Access gate. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_USER=ohjiya
BASIC_AUTH_HASH='paste-hash-here'

# Provider keys the app should use (see the repo's .env.example for the full list).
# GOOGLE_MAPS_API_KEY=
# CESIUM_ION_TOKEN=
# OPENAI_API_KEY=
# AISSTREAM_API_KEY=
