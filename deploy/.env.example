# Copy to deploy/.env and fill in. Never commit deploy/.env.
SITE_DOMAIN=x.ohjiya.sa

# Access gate. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_USER=ohjiya
BASIC_AUTH_HASH='paste-hash-here'

# Provider keys the app should use (see the repo's .env.example for the full list).
# GOOGLE_MAPS_API_KEY=
# CESIUM_ION_TOKEN=
# OPENAI_API_KEY=
# AISSTREAM_API_KEY=

# Ohjiya X accounts. Leave OHJIYA_AUTH=off until the WordPress plugin is live and
# all secrets below are set (with it on, a missing secret stops the app on purpose).
# Also delete the basic_auth block in deploy/Caddyfile when you turn it on, or
# visitors will hit the password gate before they can sign in.
# Generate each secret with: openssl rand -hex 32
OHJIYA_AUTH=off
# OXE_SSO_SECRET, OXE_API_SECRET and OXE_WEBHOOK_SECRET must equal the three
# constants in wp-config.php on ohjiya.sa. OHJIYA_SESSION_SECRET is only for this server.
OHJIYA_WP_URL=https://ohjiya.sa
OXE_SSO_SECRET=
OXE_API_SECRET=
OXE_WEBHOOK_SECRET=
OHJIYA_SESSION_SECRET=
